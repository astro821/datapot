{
  "name": "@datapot/cli",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "bin": {
    "dpot": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');const p='dist/index.js';const s=fs.readFileSync(p,'utf8');if(!s.startsWith('#!'))fs.writeFileSync(p,'#!/usr/bin/env node\\n'+s);fs.chmodSync(p,0o755)\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@datapot/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "mongodb": "^6.12.0",
    "mysql2": "^3.12.0",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
